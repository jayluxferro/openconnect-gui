{
  "name": "openconnect-gui",
  "version": "1.2.3",
  "description": "OpenConnect VPN GUI application for macOS",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173/pages/index.html && electron .\"",
    "electron:build": "vite build && electron-builder",
    "start": "npm run electron:dev",
    "package": "npm run build && electron-builder",
    "test:expect": "bash test/vpn-connect.test.sh",
    "test:install": "bash test/install-script.test.sh",
    "test:unit": "node --test test/redact.test.js test/line-logger.test.js test/openconnect-args.test.js test/main-connect-wiring.test.js test/tray-icon.test.js test/tray-menu.test.js test/tunnel-address.test.js test/profiles-storage.test.js test/ip-refresh.test.js test/auto-update.test.js test/splash-autoadvance.test.js",
    "test": "npm run test:unit && npm run test:expect && npm run test:install"
  },
  "keywords": [
    "openconnect",
    "vpn",
    "electron",
    "macos"
  ],
  "author": "Manish Jadhav",
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.309.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^5.0.12",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.openconnect.gui",
    "productName": "OpenConnect VPN",
    "files": [
      "main.js",
      "preload.js",
      "splash-preload.js",
      "password-preload.js",
      "installer-preload.js",
      "lib/**/*",
      "dist/pages/**/*",
      "dist/assets/**/*",
      "scripts/**/*",
      "!dist/mac-arm64",
      "!dist/mac-x64",
      "!dist/*.dmg",
      "!dist/*.blockmap"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vpn-connect.exp",
        "to": "vpn-connect.exp"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "pkg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "publish": {
      "provider": "github",
      "owner": "jayluxferro",
      "repo": "openconnect-gui"
    }
  }
}
